# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/iam_mitigator

# Authentication
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
# Options: none, openai
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4

# AWS Integration (DISABLED by default for safety)
AWS_INTEGRATION_ENABLED=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Application
MAX_SIMULATION_ITERATIONS=5

